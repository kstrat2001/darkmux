#!/usr/bin/env bash
#
# darkmux pre-commit hook.
#
# THIS REPO IS PUBLIC. Two jobs, in priority order:
#
#   1. Refuse to commit engagement-private content.
#   2. Keep `docs/demo/index.html` in lockstep with the viewer bundle.
#
# Install (one-time, per clone):
#     git config core.hooksPath .githooks
#
# Bypass (rare, and never to silence job 1):
#     git commit --no-verify
set -euo pipefail

# ── 1. Leak guard ───────────────────────────────────────────────────────────
#
# `scripts/engagement-sentinel-guard.py` already scans every tracked file for
# engagement identifiers, and CI runs it. But CI runs it AFTER the push — so on
# a public repo the guard reports a leak that is already published. It was
# firing on the wrong side of the boundary.
#
# Discovered 2026-08-24, alongside the finding that this hook had been INERT
# for weeks: it guarded `assets/viewer.html`, deleted in #1865, so it took its
# early exit on every commit and did nothing. A guard nobody notices has
# stopped working is worse than no guard, because it is still trusted.
#
# Scans the STAGED content, so it sees what is actually about to be committed
# rather than the working tree.
if [ -f scripts/engagement-sentinel-guard.py ]; then
  staged=$(git diff --cached --name-only --diff-filter=ACMR)
  if [ -n "$staged" ]; then
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    leaked=0
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      mkdir -p "$tmp/$(dirname "$f")"
      git show ":$f" > "$tmp/$f" 2>/dev/null || continue
    done <<< "$staged"
    if ! python3 scripts/engagement-sentinel-guard.py --scan-dir "$tmp" 2>/dev/null; then
      leaked=1
    fi
    if [ "$leaked" -ne 0 ]; then
      echo "" >&2
      echo "pre-commit: REFUSING — staged content carries an engagement identifier." >&2
      echo "            This repo is PUBLIC. Fix the content; do NOT --no-verify." >&2
      exit 1
    fi
  fi
fi

# ── 1b. Surface every NEWLY ADDED file ──────────────────────────────────────
#
# The leak guard above knows a vocabulary. It cannot know that a file is simply
# not yours — a review agent's scratch, another session's work-in-progress, a
# diff pulled from a private repo. Those have no canary words and are exactly
# what `git add -A` sweeps in; it has happened twice in one session.
#
# So: print them. Cheap, and it makes an unexpected addition impossible to
# commit without having seen it scroll past.
added=$(git diff --cached --name-only --diff-filter=A)
if [ -n "$added" ]; then
  echo "pre-commit: this commit ADDS $(echo "$added" | wc -l | tr -d ' ') file(s) to a PUBLIC repo:"
  echo "$added" | sed 's/^/             + /'
fi

# ── 2. Demo/viewer lockstep ─────────────────────────────────────────────────
VIEWER="crates/darkmux-serve/assets/next.html"
DEMO="docs/demo/index.html"
GEN="scripts/build-demo.sh"

if ! git diff --cached --name-only | grep -qx "$VIEWER"; then
  exit 0
fi

if [ ! -f "$GEN" ]; then
  echo "pre-commit: $VIEWER is staged but $GEN is missing — cannot regenerate the demo." >&2
  exit 1
fi

# The generator reads the WORKING TREE copy, not the staged one. If they differ
# (a partial `git add -p`, or an edit made after staging) regenerating would
# build the demo from content that is NOT in this commit — wrong demo AND still
# a red CI. Refuse rather than produce a mismatch.
if ! git diff --quiet -- "$VIEWER"; then
  echo "pre-commit: $VIEWER has UNSTAGED changes." >&2
  echo "            $GEN reads the working tree, so regenerating now would build the" >&2
  echo "            demo from content that isn't in this commit. Stage the whole file" >&2
  echo "            (git add $VIEWER) or commit the viewer change on its own." >&2
  exit 1
fi

bash "$GEN" >/dev/null

if ! git diff --quiet -- "$DEMO"; then
  git add "$DEMO"
  echo "pre-commit: regenerated $DEMO from the viewer and staged it."
fi

exit 0
