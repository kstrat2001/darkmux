#!/usr/bin/env python3
"""darkmux-bundler-edge — a darkmux `--bundler` plugin for Edge.js templates.

Implements darkmux's frozen external-bundler contract (darkmux#1319):

    darkmux-bundler-edge --diff <file> [--worktree <dir>]

Emits a `BundleSet` JSON document ({"bundles": [...]}) on stdout, or a clear
message on stderr + non-zero exit when the diff contains no reviewable .edge
hunks — the caller treats both a non-zero exit and an empty bundle set as
loud errors, never a silent pass.

Bundle shape per the frozen contract (vendored semantics, not imported):
  id          "<template>@<path>" — the template's basename stands in for
              the function name, since an Edge template is itself the unit.
  code        [{path, start, end}] — 1-indexed inclusive line spans the
              review pipeline resolves against the worktree. Whole-file
              spans when the template is small (they usually are); merged
              hunk windows with `truncated: true` otherwise.
  facts       mechanical `differential`-family observations from the diff:
              hunk/line counts, interpolation expressions added/removed,
              directive (@if/@each/@component/...) changes, class-attribute
              churn.
  fact_family "differential" (matching the reference Rust plugin's v1 scope)
  manifest    partials/components this template references (@include /
              @!component targets) — external symbols, per the contract.

Written for the FinHero client repos (finsys-client and friends), where the
front end is Edge templates the built-in TypeScript bundler rightly skips.
"""

import argparse
import json
import re
import sys
from pathlib import Path

WHOLE_FILE_MAX_LINES = 400
HUNK_CONTEXT_LINES = 30
FACT_LIST_CAP = 8

INTERP_RE = re.compile(r"\{\{\{?(.+?)\}?\}\}")
DIRECTIVE_RE = re.compile(r"^\s*@!?(if|elseif|else|end|each|component|include|section|slot|let|vite|unless)\b")
REF_RE = re.compile(r"@!?(?:component|include)\(\s*['\"]([^'\"]+)['\"]")


def parse_diff(diff_text):
    """Per-.edge-file hunks: {path: [(new_start, new_len, added_lines, removed_lines)]}."""
    files = {}
    path = None
    for line in diff_text.splitlines():
        if line.startswith("+++ "):
            target = line[4:].strip()
            path = None
            if target != "/dev/null":
                p = target[2:] if target.startswith("b/") else target
                if p.endswith(".edge"):
                    path = p
                    files.setdefault(path, [])
        elif line.startswith("@@") and path is not None:
            m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@", line)
            if m:
                start = int(m.group(1))
                length = int(m.group(2)) if m.group(2) is not None else 1
                files[path].append({"start": start, "len": length, "added": [], "removed": []})
        elif path is not None and files[path]:
            hunk = files[path][-1]
            if line.startswith("+") and not line.startswith("+++"):
                hunk["added"].append(line[1:])
            elif line.startswith("-") and not line.startswith("---"):
                hunk["removed"].append(line[1:])
    return {p: hunks for p, hunks in files.items() if hunks}


def uniq_capped(items):
    seen, out = set(), []
    for it in items:
        it = it.strip()
        if it and it not in seen:
            seen.add(it)
            out.append(it)
    extra = len(out) - FACT_LIST_CAP
    return (out[:FACT_LIST_CAP], extra) if extra > 0 else (out, 0)


def facts_for(hunks):
    added = [l for h in hunks for l in h["added"]]
    removed = [l for h in hunks for l in h["removed"]]
    facts = [
        f"{len(added)} line(s) added, {len(removed)} removed across {len(hunks)} hunk(s)"
    ]

    # `{{-- ... --}}` is an Edge comment, not an interpolation — skip those.
    interp_added = [m.group(1).strip() for l in added for m in INTERP_RE.finditer(l) if not m.group(1).strip().startswith("--")]
    interp_removed = [m.group(1).strip() for l in removed for m in INTERP_RE.finditer(l) if not m.group(1).strip().startswith("--")]
    gone = [e for e in interp_removed if e not in interp_added]
    new = [e for e in interp_added if e not in interp_removed]
    if new:
        vals, extra = uniq_capped(new)
        facts.append("interpolation(s) added: " + ", ".join("{{ %s }}" % v for v in vals) + (f" (+{extra} more)" if extra else ""))
    if gone:
        vals, extra = uniq_capped(gone)
        facts.append("interpolation(s) removed: " + ", ".join("{{ %s }}" % v for v in vals) + (f" (+{extra} more)" if extra else ""))

    dir_added = [l.strip() for l in added if DIRECTIVE_RE.match(l)]
    dir_removed = [l.strip() for l in removed if DIRECTIVE_RE.match(l)]
    if dir_added or dir_removed:
        facts.append(f"directive line(s) changed: {len(dir_added)} added, {len(dir_removed)} removed")

    cls_added = sum(1 for l in added if 'class="' in l)
    cls_removed = sum(1 for l in removed if 'class="' in l)
    if cls_added or cls_removed:
        facts.append(f"class-attribute line(s): {cls_added} added, {cls_removed} removed")

    return facts


def code_refs(path, hunks, worktree):
    """Whole-file span for small templates; merged hunk windows otherwise."""
    total = None
    text = None
    if worktree is not None:
        f = worktree / path
        if f.is_file():
            text = f.read_text(encoding="utf-8", errors="replace")
            total = len(text.splitlines())
    if total is not None and total <= WHOLE_FILE_MAX_LINES:
        return [{"path": path, "start": 1, "end": max(total, 1)}], False, text

    windows = []
    for h in hunks:
        start = max(1, h["start"] - HUNK_CONTEXT_LINES)
        end = h["start"] + max(h["len"], 1) - 1 + HUNK_CONTEXT_LINES
        if total is not None:
            end = min(end, total)
        if windows and start <= windows[-1]["end"] + 1:
            windows[-1]["end"] = max(windows[-1]["end"], end)
        else:
            windows.append({"path": path, "start": start, "end": end})
    return windows, True, text


def manifest_for(text, hunks, own_stem):
    source = text if text is not None else "\n".join(l for h in hunks for l in h["added"])
    # A template naming itself (e.g. in a usage example inside its own doc
    # comment) is not an external reference.
    refs, _ = uniq_capped(r for r in REF_RE.findall(source) if Path(r).stem != own_stem)
    return refs


def main():
    ap = argparse.ArgumentParser(prog="darkmux-bundler-edge")
    ap.add_argument("--worktree", type=Path, default=None)
    ap.add_argument("--diff", type=Path, required=True)
    args = ap.parse_args()

    try:
        diff_text = args.diff.read_text(encoding="utf-8", errors="replace")
    except OSError as e:
        print(f"darkmux-bundler-edge: cannot read diff file {args.diff}: {e}", file=sys.stderr)
        return 1

    files = parse_diff(diff_text)
    if not files:
        print(
            "darkmux-bundler-edge: no .edge files with reviewable hunks in this diff — nothing "
            "to bundle. (If this diff touches TypeScript, the built-in bundler is the right "
            "tool; this plugin only handles Edge templates.)",
            file=sys.stderr,
        )
        return 1

    bundles = []
    for path, hunks in sorted(files.items()):
        code, truncated, text = code_refs(path, hunks, args.worktree)
        template = Path(path).stem
        bundle = {
            "id": f"{template}@{path}",
            "code": code,
            "facts": facts_for(hunks),
            "fact_family": "differential",
        }
        manifest = manifest_for(text, hunks, template)
        if manifest:
            bundle["manifest"] = manifest
        if truncated:
            bundle["truncated"] = True
        bundles.append(bundle)

    print(json.dumps({"bundles": bundles}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
