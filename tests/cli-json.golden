# verbs: what each prints under --json
dispatch <role> (a container execution)  DispatchEnvelope
dispatch <role> (a hosted-endpoint execution)  DirectDispatchEnvelope
finding list  FindingList
finding show  FindingRecord
finding sync  SyncReport
flow drain  DrainOutput
flow drain --file  StrayDrainOutput
flow integrity-check  IntegrityCheckOutput
flow status  FlowStatus
lab loop  LoopReport
lab loop --ab  LoopAbReport
machine list  FleetView
machine resources  ModelLedger
machine resources <peer>  MachineResourcesResponse
machine status  MachineStatusOutput
memory correction list  CorrectionList
memory lesson export  LessonsExport
memory lesson list  LessonTiers
memory lesson recall  LessonTiers
mission config list  ConfigList
mission config show  ConfigShow
mission debrief  DebriefReport
mission show  MissionShow
mission status  MissionBoard
mod create  ModCreated
mod list  ModList
mod show  ModRecord
profile draft  ProfileDraft
profile list  ProfileList
profile list --machine <peer>  PeerProfileList
profile list --remote  PeerProfileList
role list  RoleList
role show  RoleShow
run list  RunListOutput
run stats <one run>  RunStats
run stats <several runs, or --baseline>  RunSetStats

# streams: one record per line
flow tail  one flow record per line, verbatim; the record is pinned by FLOW_SCHEMA_VERSION, not by this file

# types
AbandonReason = "aborted" | "noterminal" | "unknown"
AcceptsState = { accepts: CardAccepts; state: "granted" } | { state: "not_listed" } | { state: "this_machine" } | { state: "unknown" }
ActiveWait
