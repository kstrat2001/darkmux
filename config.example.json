{
  "schema_version": "2.3",
  "machine_id": "my-machine",
  "lms_bin": "lms",
  "lmstudio_url": "http://localhost:1234",
  "redis": {
    "enabled": false,
    "host": "127.0.0.1",
    "port": 6379,
    "stream": "darkmux:flow",
    "maxlen": 10000,
    "telemetry_maxlen": 10000
  },
  "audit": {
    "enabled": false,
    "dir": "~/.darkmux/audit"
  },
  "runtime": {
    "inactivity_timeout_seconds": 600,
    "model_load_timeout_seconds": 600,
    "step_command_timeout_seconds": 600,
    "mission_wall_clock_timeout_seconds": 0,
    "dispatch_free_concurrency": 8,
    "strict_selection": false,
    "feedback_injection": true,
    "check_updates": true,
    "injected_context_fraction": 0.15,
    "acp_idle_exit_minutes": 30,
    "turn_delay_ms": 0,
    "host_sampler_interval_ms": 5000,
    "live_sample_ms": 250,
    "thermal": {
      "enabled": true,
      "pause_at": "serious",
      "resume_at": "fair",
      "resume_hold_ms": 60000,
      "max_pause_ms": 900000,
      "min_cpu_speed_limit_pct": 50,
      "speed_limit_hold_samples": 3,
      "duty_delay_ms": 15000,
      "ratchet_factor": 2,
      "episode_threshold": 2,
      "tier4_enabled": true
    },
    "detection": {
      "degeneracy": {
        "policy": "conclude"
      }
    },
    "liveness_retention_hours": 168,
    "verbose": false
  },
  "fleet": {
    "mode": "standalone",
    "identity": {
      "provider": "tailscale"
    },
    "listener": {
      "enabled": false,
      "port": 8766
    },
    "accept_work": {},
    "busy_policy": "refuse",
    "defaults": {
      "radio": {
        "answerer_profile": ""
      }
    }
  },
  "power": {
    "min_battery_pct": 50,
    "refuse_start_below_min": true,
    "pause_running_below_min": true
  },
  "mission": {
    "stale_active_days": 14
  },
  "radio": {
    "answerer_profile": "",
    "humor": 50
  },
  "cmd": {
    "enabled": false,
    "allowed": []
  },
  "hooks": {
    "enabled": false,
    "outbox_dir": "~/.darkmux/hooks",
    "rules": [],
    "max_outbox_mb": 256,
    "jq_timeout_ms": 5000,
    "jq_max_output_bytes": 1048576
  },
  "serve": {
    "port": 8765,
    "bind": "127.0.0.1",
    "token_keychain": false,
    "read_auth": false
  },
  "role_profiles": {}
}
